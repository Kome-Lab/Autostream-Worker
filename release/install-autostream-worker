#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="worker"
readonly ARTIFACT_PREFIX="autostream-worker"
readonly MANIFEST_SERVICE="${SERVICE_NAME}"
readonly MANAGED_ROOT="/opt/autostream/worker"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/autostream-worker"
readonly PUBLIC_ALIAS="/usr/local/bin/worker"
readonly ENV_DEST="/etc/autostream/worker.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-worker.service"
readonly UNIT_NAME="autostream-worker.service"
readonly STATE_DIR="/var/lib/autostream/worker"
readonly INSTALL_MIGRATION_ROOT="/var/backups/autostream/install-migrations"
readonly LEGACY_BACKUP_ROOT="${INSTALL_MIGRATION_ROOT}/worker"

die() {
  printf 'install-autostream-worker: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname find flock getent grep groupadd id install jq \
  ln mktemp mv readlink rm runuser sha256sum sort stat sync systemctl tar uname \
  useradd wc; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done

service_was_active=false
if systemctl is-active --quiet "${UNIT_NAME}"; then
  service_was_active=true
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || \
  die "could not resolve the installer directory"
[[ -n ${SCRIPT_DIR} && ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} && ! -L ${SCRIPT_DIR} ]] || \
  die "installer directory is missing or unsafe"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")" || \
  die "could not resolve the artifact directory name"
[[ -n ${ARTIFACT_ID} && ${ARTIFACT_ID} != */* ]] || \
  die "artifact directory name is empty or unsafe"
readonly ARTIFACT_ID
readonly ARTIFACT_PATTERN="^${ARTIFACT_PREFIX}_(v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?)_linux_(amd64|arm64)$"
if [[ ! ${ARTIFACT_ID} =~ ${ARTIFACT_PATTERN} ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[3]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || \
  die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")" || \
  die "could not resolve the artifact parent directory"
[[ -n ${ARTIFACT_PARENT} && ${ARTIFACT_PARENT} == /* &&
  -d ${ARTIFACT_PARENT} && ! -L ${ARTIFACT_PARENT} ]] || \
  die "artifact parent directory is missing or unsafe"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
readonly ARCHIVE_CHECKSUM_SOURCE="${ARCHIVE_SOURCE}.sha256"
readonly MANIFEST_SOURCE="${ARTIFACT_PARENT}/release-manifest.json"
readonly MANIFEST_CHECKSUM_SOURCE="${ARTIFACT_PARENT}/release-manifest.json.sha256"

for source in \
  "${ARCHIVE_SOURCE}" \
  "${ARCHIVE_CHECKSUM_SOURCE}" \
  "${MANIFEST_SOURCE}" \
  "${MANIFEST_CHECKSUM_SOURCE}"; do
  [[ -f ${source} && ! -L ${source} ]] || \
    die "required verified release file is missing or unsafe: ${source}"
done

verify_root_permission_boundary() {
  local path=$1
  local mode

  [[ -d ${path} && ! -L ${path} ]] || \
    die "permission boundary is missing or unsafe: ${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "permission boundary must resolve to its canonical path: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
    die "permission boundary must be owned by root:root: ${path}"
  mode="$(stat -c '%a' -- "${path}")"
  (( (8#${mode} & 0022) == 0 )) || \
    die "permission boundary must not be group/other writable: ${path}"
}

verify_existing_root_permission_boundary() {
  local path=$1

  if [[ -e ${path} || -L ${path} ]]; then
    verify_root_permission_boundary "${path}"
  fi
}

verify_root_sticky_temp_boundary() {
  local path=$1
  local mode

  [[ -d ${path} && ! -L ${path} ]] || \
    die "temporary-file boundary is missing or unsafe: ${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "temporary-file boundary must resolve to its canonical path: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
    die "temporary-file boundary must be owned by root:root: ${path}"
  mode="$(stat -c '%a' -- "${path}")"
  (( (8#${mode} & 01000) != 0 )) || \
    die "temporary-file boundary must have the sticky bit set: ${path}"
}

verify_existing_worker_state_directory() {
  local state_mode

  if [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]]; then
    return 0
  fi
  [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} ]] || \
    die "Worker state path must be a non-symlink directory"
  [[ $(readlink -f -- "${STATE_DIR}") == "${STATE_DIR}" ]] || \
    die "Worker state path must resolve to its canonical path"
  [[ $(stat -c '%U:%G' -- "${STATE_DIR}") == "autostream:autostream" ]] || \
    die "Worker state path has unexpected ownership"
  state_mode="$(stat -c '%a' -- "${STATE_DIR}")"
  (( (8#${state_mode} & 07022) == 0 )) || \
    die "Worker state path has unsafe write or special mode bits"
}

for boundary in \
  /opt \
  /usr \
  /usr/local \
  /usr/local/bin \
  /etc \
  /etc/systemd \
  /etc/systemd/system \
  /var \
  /var/lib \
  /run; do
  verify_root_permission_boundary "${boundary}"
done
verify_root_sticky_temp_boundary /var/tmp
for boundary in \
  /opt/autostream \
  "${MANAGED_ROOT}" \
  "${RELEASES_DIR}" \
  /var/lib/autostream \
  /etc/autostream \
  /var/backups \
  /var/backups/autostream \
  "${INSTALL_MIGRATION_ROOT}" \
  "${LEGACY_BACKUP_ROOT}" \
  /run/autostream-updater; do
  verify_existing_root_permission_boundary "${boundary}"
done
verify_existing_worker_state_directory

input_stage=""
if ! input_stage="$(mktemp -d /var/tmp/autostream-worker-install.XXXXXXXX)"; then
  die "failed to create input staging directory"
fi
[[ -n ${input_stage} ]] || die "mktemp returned an empty input staging path"
[[ ${input_stage} == /var/tmp/autostream-worker-install.* &&
  $(dirname -- "${input_stage}") == "/var/tmp" &&
  -d ${input_stage} && ! -L ${input_stage} &&
  $(readlink -f -- "${input_stage}") == "${input_stage}" &&
  $(stat -c '%U:%G:%a' -- "${input_stage}") == "root:root:700" ]] || \
  die "mktemp returned an unsafe input staging directory"
readonly INPUT_STAGE="${input_stage}"
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"
managed_candidate=""
installation_committed=false
current_changed=false
previous_current_target=""
unit_installed=false
previous_unit_exists=false
previous_unit_mode=""
previous_unit_identity=""
previous_unit_sha256=""
legacy_unit_needs_backup=false
created_env=false
created_env_identity=""
created_env_sha256=""
preserve_input_stage=false
declare -a changed_public_paths=()
declare -a previous_public_kinds=()
declare -a previous_public_targets=()
declare -a previous_public_recoveries=()
declare -A interrupted_public_backups=()
legacy_backup_stage=""
declare -a mutated_filesystem_parents=("/var/tmp" "${INPUT_STAGE}")

record_mutated_parent() {
  local parent=$1
  local recorded

  for recorded in "${mutated_filesystem_parents[@]}"; do
    [[ ${recorded} == "${parent}" ]] && return 0
  done
  mutated_filesystem_parents+=("${parent}")
}

sync_installation_parents() {
  local parent

  for parent in "${mutated_filesystem_parents[@]}"; do
    [[ -d ${parent} && ! -L ${parent} ]] || \
      die "mutated filesystem parent is missing or unsafe before commit: ${parent}"
    sync -f "${parent}" || \
      die "failed to sync filesystem parent before commit: ${parent}"
  done
}

best_effort_sync_mutated_parents() {
  local parent
  local failed=false

  for parent in "${mutated_filesystem_parents[@]}"; do
    if [[ -d ${parent} && ! -L ${parent} ]]; then
      sync -f "${parent}" || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

rollback_public_links() {
  local index
  local path
  local kind
  local target
  local recovery
  local rollback_next
  local expected_digest
  local failed=false

  for ((index=${#changed_public_paths[@]} - 1; index >= 0; index--)); do
    path="${changed_public_paths[index]}"
    kind="${previous_public_kinds[index]}"
    target="${previous_public_targets[index]}"
    recovery="${previous_public_recoveries[index]}"
    case "${kind}" in
      regular)
        if [[ ! -f ${recovery} || -L ${recovery} ]]; then
          failed=true
          continue
        fi
        expected_digest="$(sha256sum -- "${recovery}" | awk 'NR == 1 { print $1 }')"
        rollback_next="${path}.rollback.$$"
        rm -f -- "${rollback_next}" || failed=true
        if cp -a -- "${recovery}" "${rollback_next}"; then
          mv -Tf -- "${rollback_next}" "${path}" || failed=true
        else
          failed=true
        fi
        [[ -f ${path} &&
          ! -L ${path} &&
          $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == "${expected_digest}" ]] || \
          failed=true
        ;;
      symlink)
        rollback_next="${path}.rollback.$$"
        rm -f -- "${rollback_next}" || failed=true
        ln -s -- "${target}" "${rollback_next}" || failed=true
        if [[ -L ${rollback_next} ]]; then
          mv -Tf -- "${rollback_next}" "${path}" || failed=true
        fi
        [[ -L ${path} && $(readlink -- "${path}") == "${target}" ]] || failed=true
        ;;
      absent)
        rm -f -- "${path}" || failed=true
        [[ ! -e ${path} && ! -L ${path} ]] || failed=true
        ;;
    esac
    sync -f "$(dirname -- "${path}")" || failed=true
  done
  [[ ${failed} == false ]]
}

rollback_current_link() {
  local rollback_next
  local failed=false

  [[ ${current_changed} == true ]] || return 0
  if [[ -n ${previous_current_target} ]]; then
    rollback_next="${MANAGED_ROOT}/.current.rollback.$$"
    rm -f -- "${rollback_next}" || failed=true
    ln -s -- "${previous_current_target}" "${rollback_next}" || failed=true
    if [[ -L ${rollback_next} ]]; then
      mv -Tf -- "${rollback_next}" "${CURRENT_LINK}" || failed=true
    fi
    [[ -L ${CURRENT_LINK} &&
      $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || \
      failed=true
  else
    rm -f -- "${CURRENT_LINK}" || failed=true
    [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || failed=true
  fi
  sync -f "${MANAGED_ROOT}" || failed=true
  [[ ${failed} == false ]]
}

rollback_unit_and_environment() {
  local unit_rollback_next
  local unit_recovered=true
  local failed=false

  if [[ ${unit_installed} == true ]]; then
    if [[ ${previous_unit_exists} == true ]]; then
      unit_recovered=false
      unit_rollback_next="${UNIT_DEST}.rollback.$$"
      rm -f -- "${unit_rollback_next}" || failed=true
      if [[ -f ${INPUT_STAGE}/previous-autostream-worker.service &&
        ! -L ${INPUT_STAGE}/previous-autostream-worker.service ]] &&
        install -o root -g root -m "${previous_unit_mode}" \
          "${INPUT_STAGE}/previous-autostream-worker.service" \
          "${unit_rollback_next}" &&
        mv -Tf -- "${unit_rollback_next}" "${UNIT_DEST}" &&
        [[ -f ${UNIT_DEST} &&
          ! -L ${UNIT_DEST} &&
          $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == \
            "root:root:${previous_unit_mode}" &&
          $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
            "${previous_unit_sha256}" ]]; then
        unit_recovered=true
      else
        failed=true
      fi
    else
      rm -f -- "${UNIT_DEST}" || failed=true
      [[ ! -e ${UNIT_DEST} && ! -L ${UNIT_DEST} ]] || {
        unit_recovered=false
        failed=true
      }
    fi
    if [[ ${unit_recovered} == true ]]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  elif [[ ${previous_unit_exists} == true ]]; then
    [[ -f ${UNIT_DEST} &&
      ! -L ${UNIT_DEST} &&
      $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == \
        "root:root:${previous_unit_mode}" &&
      $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
        "${previous_unit_sha256}" ]] || {
      unit_recovered=false
      failed=true
    }
  fi
  rm -f -- "${UNIT_DEST}.next.$$" || failed=true
  sync -f /etc/systemd/system || failed=true

  if [[ ${created_env} == true ]]; then
    if [[ -f ${ENV_DEST} &&
      ! -L ${ENV_DEST} &&
      $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${ENV_DEST}") == "${created_env_identity}" &&
      $(sha256sum -- "${ENV_DEST}" | awk 'NR == 1 { print $1 }') == "${created_env_sha256}" ]]; then
      rm -f -- "${ENV_DEST}" || failed=true
      [[ ! -e ${ENV_DEST} && ! -L ${ENV_DEST} ]] || failed=true
    else
      printf 'install-autostream-worker: preserving environment file modified during failed installation: %s\n' \
        "${ENV_DEST}" >&2
    fi
  fi
  rm -f -- "${ENV_DEST}.next.$$" || failed=true
  sync -f /etc/autostream || failed=true
  if [[ ${unit_recovered} != true ]]; then
    preserve_input_stage=true
  fi
  [[ ${failed} == false ]]
}

cleanup() {
  local original_status=$?
  set +e
  local rollback_failed=false

  if [[ ${installation_committed} != true ]]; then
    rollback_public_links || rollback_failed=true
    rollback_current_link || rollback_failed=true
    rollback_unit_and_environment || rollback_failed=true
  fi
  best_effort_sync_mutated_parents || rollback_failed=true
  if [[ ${rollback_failed} == true ]]; then
    preserve_input_stage=true
  fi
  if [[ -n ${managed_candidate} && -e ${managed_candidate} ]]; then
    rm -rf -- "${managed_candidate}" || rollback_failed=true
  fi
  if [[ -n ${legacy_backup_stage} ]]; then
    rm -f -- "${legacy_backup_stage}" || rollback_failed=true
  fi
  if [[ ${preserve_input_stage} == true ]]; then
    printf 'install-autostream-worker: preserved recovery files at %s\n' \
      "${INPUT_STAGE}" >&2
  else
    rm -rf -- "${INPUT_STAGE}" || rollback_failed=true
  fi
  best_effort_sync_mutated_parents || rollback_failed=true
  if [[ ${rollback_failed} == true ]]; then
    printf 'install-autostream-worker: one or more cleanup operations failed; inspect host state before retrying\n' >&2
  fi
  return "${original_status}"
}
trap cleanup EXIT
install -d -o root -g root -m 0700 "${UNPACK_DIR}"
record_mutated_parent "${UNPACK_DIR}"

copy_stable_source() {
  local source=$1
  local destination=$2
  local identity
  local digest

  identity="$(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}")"
  digest="$(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }')"
  install -o root -g root -m 0600 "${source}" "${destination}"
  [[ -f ${source} && ! -L ${source} ]] || \
    die "release source changed while being staged: ${source}"
  [[ $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${source}") == "${identity}" ]] || \
    die "release source identity changed while being staged: ${source}"
  [[ $(sha256sum -- "${source}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "release source content changed while being staged: ${source}"
  [[ $(sha256sum -- "${destination}" | awk 'NR == 1 { print $1 }') == "${digest}" ]] || \
    die "staged release file differs from its source: ${source}"
}

ensure_root_directory() {
  local path=$1
  local requested_mode=$2
  local expected_mode="${requested_mode#0}"
  local existing_mode

  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} ]] || \
      die "root-owned directory path is unsafe: ${path}"
    [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
      die "root-owned directory has unexpected ownership: ${path}"
    existing_mode="$(stat -c '%a' -- "${path}")"
    (( (8#${existing_mode} & 0022) == 0 )) || \
      die "root-owned directory is group/other writable: ${path}"
  fi
  install -d -o root -g root -m "${requested_mode}" "${path}"
  [[ $(stat -c '%U:%G:%a' -- "${path}") == "root:root:${expected_mode}" ]] || \
    die "root-owned directory mode verification failed: ${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "root-owned directory must resolve to its exact canonical path: ${path}"
}

copy_stable_source "${ARCHIVE_SOURCE}" "${INPUT_STAGE}/${ARCHIVE_NAME}"
copy_stable_source "${ARCHIVE_CHECKSUM_SOURCE}" "${INPUT_STAGE}/${ARCHIVE_NAME}.sha256"
copy_stable_source "${MANIFEST_SOURCE}" "${INPUT_STAGE}/release-manifest.json"
copy_stable_source "${MANIFEST_CHECKSUM_SOURCE}" "${INPUT_STAGE}/release-manifest.json.sha256"

verify_checksum_file() {
  local checksum_path=$1
  local expected_name=$2
  local declared_name

  [[ $(wc -l < "${checksum_path}") -eq 1 ]] || \
    die "checksum file must contain exactly one line: ${checksum_path}"
  grep -Eq '^[0-9a-f]{64}  [^/[:space:]]+$' "${checksum_path}" || \
    die "checksum file has an invalid format: ${checksum_path}"
  declared_name="$(awk 'NR == 1 { print $2 }' "${checksum_path}")"
  [[ ${declared_name} == "${expected_name}" ]] || \
    die "checksum file names ${declared_name}, expected ${expected_name}"
}

verify_checksum_file "${INPUT_STAGE}/${ARCHIVE_NAME}.sha256" "${ARCHIVE_NAME}"
verify_checksum_file "${INPUT_STAGE}/release-manifest.json.sha256" "release-manifest.json"
(cd -- "${INPUT_STAGE}" && sha256sum --check --strict "${ARCHIVE_NAME}.sha256")
(cd -- "${INPUT_STAGE}" && sha256sum --check --strict release-manifest.json.sha256)

ARTIFACT_SHA256="$(
  sha256sum -- "${INPUT_STAGE}/${ARCHIVE_NAME}" | awk 'NR == 1 { print $1 }'
)" || die "could not calculate the artifact SHA-256 digest"
[[ ${ARTIFACT_SHA256} =~ ^[0-9a-f]{64}$ ]] || \
  die "could not calculate a valid artifact SHA-256 digest"
readonly ARTIFACT_SHA256
ARTIFACT_SIZE="$(stat -c %s -- "${INPUT_STAGE}/${ARCHIVE_NAME}")" || \
  die "could not calculate the artifact size"
[[ ${ARTIFACT_SIZE} =~ ^[1-9][0-9]*$ ]] || \
  die "could not calculate a positive artifact size"
readonly ARTIFACT_SIZE
jq -e \
  --arg version "${VERSION}" \
  --arg prefix "${ARTIFACT_PREFIX}" \
  --arg service "${MANIFEST_SERVICE}" \
  --arg arch "${ARCH}" \
  --arg name "${ARCHIVE_NAME}" \
  --arg sha256 "${ARTIFACT_SHA256}" \
  --argjson size "${ARTIFACT_SIZE}" \
  '((keys | sort) ==
     ["channel", "components", "minimum_agent_version", "published_at", "release_id", "schema_version"]) and
   (.schema_version == 1) and
   (.release_id == $version) and
   (.channel == "host") and
   (.published_at | type == "string" and
     test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and
   (.minimum_agent_version | type == "string" and
     test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) and
   (.components | type == "array" and length == 1) and
   (.components[0] | type == "object") and
   ((.components[0] | keys | sort) ==
     ["artifacts", "commit", "database_schema", "rollback_compatible", "service", "source_version"]) and
   (.components[0].service == $service) and
   (.components[0].source_version == $version) and
   (.components[0].commit | type == "string" and test("^[0-9a-f]{40}$")) and
   (.components[0].rollback_compatible == true) and
   (.components[0].database_schema == "none") and
   (.components[0].artifacts | type == "array" and length == 2) and
   ([.components[0].artifacts[].arch] | sort == ["amd64", "arm64"]) and
   (all(.components[0].artifacts[];
     (type == "object") and
     ((keys | sort) == ["arch", "name", "os", "sha256", "size"]) and
     (.os == "linux") and
     (.arch == "amd64" or .arch == "arm64") and
     (.name == ($prefix + "_" + $version + "_linux_" + .arch + ".tar.gz")) and
     (.size | type == "number" and . > 0 and . <= 268435456) and
     (.sha256 | type == "string" and test("^[0-9a-f]{64}$")))) and
   ([.components[0].artifacts[] |
      select(.arch == $arch and
             .name == $name and
             .sha256 == $sha256 and
             .size == $size)] | length == 1)' \
  "${INPUT_STAGE}/release-manifest.json" >/dev/null || \
  die "release-manifest.json does not authorize this exact artifact"

tar -tzf "${INPUT_STAGE}/${ARCHIVE_NAME}" > "${INPUT_STAGE}/archive.list"
[[ -s ${INPUT_STAGE}/archive.list ]] || die "release archive is empty"
while IFS= read -r entry; do
  [[ ${entry} =~ ^[A-Za-z0-9._/-]+$ ]] || \
    die "release archive contains an unsafe path: ${entry}"
  [[ ${entry} == "${ARTIFACT_ID}" ||
    ${entry} == "${ARTIFACT_ID}/" ||
    ${entry} == "${ARTIFACT_ID}/"* ]] || \
    die "release archive contains a path outside ${ARTIFACT_ID}: ${entry}"
  [[ ${entry} != /* &&
    ${entry} != ../* &&
    ${entry} != *"/../"* &&
    ${entry} != *"/.." ]] || \
    die "release archive contains an unsafe path: ${entry}"
done < "${INPUT_STAGE}/archive.list"
duplicate_paths="$(sort "${INPUT_STAGE}/archive.list" | uniq -d)"
[[ -z ${duplicate_paths} ]] || die "release archive contains duplicate paths"
while IFS= read -r entry; do
  case "${entry:0:1}" in
    -|d) ;;
    *) die "release archive contains a symlink, hardlink, or other unsupported entry" ;;
  esac
done < <(tar -tvzf "${INPUT_STAGE}/${ARCHIVE_NAME}")

tar --no-same-owner --no-same-permissions \
  -xzf "${INPUT_STAGE}/${ARCHIVE_NAME}" \
  -C "${UNPACK_DIR}"
readonly EXTRACTED_ROOT="${UNPACK_DIR}/${ARTIFACT_ID}"
[[ -d ${EXTRACTED_ROOT} && ! -L ${EXTRACTED_ROOT} ]] || \
  die "release archive root is missing or unsafe"
[[ -z $(find "${UNPACK_DIR}" -mindepth 1 -maxdepth 1 ! -name "${ARTIFACT_ID}" -print -quit) ]] || \
  die "release archive contains more than one top-level path"
[[ -z $(find "${EXTRACTED_ROOT}" -type l -print -quit) ]] || \
  die "release archive must not contain symlinks"
for reserved_marker in .artifact-sha256 .version; do
  [[ ! -e ${EXTRACTED_ROOT}/${reserved_marker} &&
    ! -L ${EXTRACTED_ROOT}/${reserved_marker} ]] || \
    die "release archive must not provide ${reserved_marker}"
done

find "${EXTRACTED_ROOT}" -type d -exec chmod 0755 {} +
find "${EXTRACTED_ROOT}" -type f -exec chmod 0644 {} +
for executable in \
  "${EXTRACTED_ROOT}/bin/autostream-worker" \
  "${EXTRACTED_ROOT}/bin/worker" \
  "${EXTRACTED_ROOT}/install-autostream-worker"; do
  [[ -f ${executable} && ! -L ${executable} ]] || \
    die "required executable is missing or unsafe: ${executable#${EXTRACTED_ROOT}/}"
  chmod 0755 "${executable}"
done

[[ -f ${EXTRACTED_ROOT}/checksums.txt && ! -L ${EXTRACTED_ROOT}/checksums.txt ]] || \
  die "release checksums.txt is missing or unsafe"

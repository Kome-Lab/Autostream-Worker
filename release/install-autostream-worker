#!/bin/bash
set -euo pipefail

umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

readonly SERVICE_NAME="worker"
readonly ARTIFACT_PREFIX="autostream-worker"
readonly ARTIFACT_MANIFEST_NAME="artifact-manifest.json"
readonly MANAGED_ROOT="/opt/autostream/worker"
readonly RELEASES_DIR="${MANAGED_ROOT}/releases"
readonly CURRENT_LINK="${MANAGED_ROOT}/current"
readonly PUBLIC_BINARY="/usr/local/bin/autostream-worker"
readonly PUBLIC_ALIAS="/usr/local/bin/worker"
readonly ENV_DEST="/etc/autostream/worker.env"
readonly UNIT_DEST="/etc/systemd/system/autostream-worker.service"
readonly UNIT_NAME="autostream-worker.service"
readonly STATE_DIR="/var/lib/autostream/worker"
readonly INSTALL_MIGRATION_ROOT="/var/backups/autostream/install-migrations"
readonly LEGACY_BACKUP_ROOT="${INSTALL_MIGRATION_ROOT}/worker"

die() {
  printf 'install-autostream-worker: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root (use sudo)"
[[ $# -eq 0 ]] || die "this installer does not accept arguments"

for command in \
  awk basename chmod chown cmp cp dirname find flock getent grep groupadd groupdel id install jq \
  ln mkdir mktemp mv readlink rm rmdir runuser sha256sum sort stat sync systemctl tar uname \
  uniq useradd userdel; do
  command -v "${command}" >/dev/null 2>&1 || die "required command is unavailable: ${command}"
done

service_was_active=false
if systemctl is-active --quiet "${UNIT_NAME}"; then
  service_was_active=true
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" || \
  die "could not resolve the installer directory"
[[ -n ${SCRIPT_DIR} && ${SCRIPT_DIR} == /* && -d ${SCRIPT_DIR} && ! -L ${SCRIPT_DIR} ]] || \
  die "installer directory is missing or unsafe"
readonly SCRIPT_DIR
ARTIFACT_ID="$(basename -- "${SCRIPT_DIR}")" || \
  die "could not resolve the artifact directory name"
[[ -n ${ARTIFACT_ID} && ${ARTIFACT_ID} != */* ]] || \
  die "artifact directory name is empty or unsafe"
readonly ARTIFACT_ID
readonly ARTIFACT_PATTERN="^${ARTIFACT_PREFIX}_(v[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?)_linux_(amd64|arm64)$"
if [[ ! ${ARTIFACT_ID} =~ ${ARTIFACT_PATTERN} ]]; then
  die "the extracted directory name is invalid: ${ARTIFACT_ID}"
fi
readonly VERSION="${BASH_REMATCH[1]}"
readonly ARCH="${BASH_REMATCH[3]}"

case "$(uname -m)" in
  x86_64) readonly HOST_ARCH="amd64" ;;
  aarch64|arm64) readonly HOST_ARCH="arm64" ;;
  *) die "unsupported host architecture: $(uname -m)" ;;
esac
[[ ${ARCH} == "${HOST_ARCH}" ]] || \
  die "artifact architecture ${ARCH} does not match host ${HOST_ARCH}"

ARTIFACT_PARENT="$(dirname -- "${SCRIPT_DIR}")" || \
  die "could not resolve the artifact parent directory"
[[ -n ${ARTIFACT_PARENT} && ${ARTIFACT_PARENT} == /* &&
  -d ${ARTIFACT_PARENT} && ! -L ${ARTIFACT_PARENT} ]] || \
  die "artifact parent directory is missing or unsafe"
readonly ARTIFACT_PARENT
readonly ARCHIVE_NAME="${ARTIFACT_ID}.tar.gz"
readonly ARCHIVE_SOURCE="${ARTIFACT_PARENT}/${ARCHIVE_NAME}"
[[ -f ${ARCHIVE_SOURCE} && ! -L ${ARCHIVE_SOURCE} ]] || \
  die "required release archive is missing or unsafe: ${ARCHIVE_SOURCE}"
ARTIFACT_SIZE="$(stat -c %s -- "${ARCHIVE_SOURCE}")" || \
  die "could not calculate the artifact size"
[[ ${ARTIFACT_SIZE} =~ ^[1-9][0-9]*$ ]] || \
  die "could not calculate a positive artifact size"
(( ARTIFACT_SIZE <= 268435456 )) || \
  die "release archive exceeds the 256 MiB safety limit"
readonly ARTIFACT_SIZE

verify_root_permission_boundary() {
  local path=$1
  local mode

  [[ -d ${path} && ! -L ${path} ]] || \
    die "permission boundary is missing or unsafe: ${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "permission boundary must resolve to its canonical path: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
    die "permission boundary must be owned by root:root: ${path}"
  mode="$(stat -c '%a' -- "${path}")"
  (( (8#${mode} & 0022) == 0 )) || \
    die "permission boundary must not be group/other writable: ${path}"
}

verify_existing_root_permission_boundary() {
  local path=$1

  if [[ -e ${path} || -L ${path} ]]; then
    verify_root_permission_boundary "${path}"
  fi
}

verify_root_sticky_temp_boundary() {
  local path=$1
  local mode

  [[ -d ${path} && ! -L ${path} ]] || \
    die "temporary-file boundary is missing or unsafe: ${path}"
  [[ $(readlink -f -- "${path}") == "${path}" ]] || \
    die "temporary-file boundary must resolve to its canonical path: ${path}"
  [[ $(stat -c '%U:%G' -- "${path}") == "root:root" ]] || \
    die "temporary-file boundary must be owned by root:root: ${path}"
  mode="$(stat -c '%a' -- "${path}")"
  (( (8#${mode} & 01000) != 0 )) || \
    die "temporary-file boundary must have the sticky bit set: ${path}"
}

verify_existing_worker_state_directory() {
  local state_mode

  if [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]]; then
    return 0
  fi
  [[ -d ${STATE_DIR} && ! -L ${STATE_DIR} ]] || \
    die "Worker state path must be a non-symlink directory"
  [[ $(readlink -f -- "${STATE_DIR}") == "${STATE_DIR}" ]] || \
    die "Worker state path must resolve to its canonical path"
  [[ $(stat -c '%U:%G' -- "${STATE_DIR}") == "autostream:autostream" ]] || \
    die "Worker state path has unexpected ownership"
  state_mode="$(stat -c '%a' -- "${STATE_DIR}")"
  (( (8#${state_mode} & 07022) == 0 )) || \
    die "Worker state path has unsafe write or special mode bits"
}

for boundary in \
  /opt \
  /usr \
  /usr/local \
  /usr/local/bin \
  /etc \
  /etc/systemd \
  /etc/systemd/system \
  /var \
  /var/lib \
  /run; do
  verify_root_permission_boundary "${boundary}"
done
verify_root_sticky_temp_boundary /var/tmp
for boundary in \
  /opt/autostream \
  "${MANAGED_ROOT}" \
  "${RELEASES_DIR}" \
  /var/lib/autostream \
  /etc/autostream \
  /var/backups \
  /var/backups/autostream \
  "${INSTALL_MIGRATION_ROOT}" \
  "${LEGACY_BACKUP_ROOT}" \
  /run/autostream-updater; do
  verify_existing_root_permission_boundary "${boundary}"
done
verify_existing_worker_state_directory

state_dir_existed=false
state_dir_mutated=false
state_dir_original_identity=""
state_dir_original_owner=""
state_dir_original_mode=""
state_dir_created_identity=""
if [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
  state_dir_existed=true
  state_dir_original_identity="$(stat -c '%d:%i' -- "${STATE_DIR}")"
  state_dir_original_owner="$(stat -c '%u:%g' -- "${STATE_DIR}")"
  state_dir_original_mode="$(stat -c '%a' -- "${STATE_DIR}")"
fi

verify_state_directory_snapshot() {
  if [[ ${state_dir_existed} == true ]]; then
    [[ -d ${STATE_DIR} &&
      ! -L ${STATE_DIR} &&
      $(readlink -f -- "${STATE_DIR}") == "${STATE_DIR}" &&
      $(stat -c '%d:%i:%u:%g:%a' -- "${STATE_DIR}") == \
        "${state_dir_original_identity}:${state_dir_original_owner}:${state_dir_original_mode}" ]] || \
      die "Worker state path changed after preflight"
  else
    [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]] || \
      die "Worker state path appeared after preflight"
  fi
}

deferred_termination_status=0

exit_from_termination_signal() {
  trap '' HUP INT TERM
  local signal_status=$1
  exit "${signal_status}"
}

install_termination_signal_handlers() {
  trap 'exit_from_termination_signal 129' HUP
  trap 'exit_from_termination_signal 130' INT
  trap 'exit_from_termination_signal 143' TERM
}

defer_termination_signals() {
  trap 'deferred_termination_status=129' HUP
  trap 'deferred_termination_status=130' INT
  trap 'deferred_termination_status=143' TERM
}

resume_termination_signals() {
  local pending_status

  install_termination_signal_handlers
  pending_status=${deferred_termination_status}
  deferred_termination_status=0
  if (( pending_status != 0 )); then
    exit_from_termination_signal "${pending_status}"
  fi
}

input_stage=""
cleanup_early_input_stage() {
  local original_status=$?

  trap '' HUP INT TERM
  trap - EXIT
  set +e

  if [[ -n ${input_stage} &&
    ${input_stage} == /var/tmp/autostream-worker-install.* &&
    $(dirname -- "${input_stage}") == "/var/tmp" &&
    -d ${input_stage} &&
    ! -L ${input_stage} &&
    $(readlink -f -- "${input_stage}") == "${input_stage}" ]]; then
    rm -rf -- "${input_stage}"
    sync -f /var/tmp >/dev/null 2>&1 || true
  fi
  return "${original_status}"
}
defer_termination_signals
if ! input_stage="$(mktemp -d /var/tmp/autostream-worker-install.XXXXXXXX)"; then
  die "failed to create input staging directory"
fi
trap cleanup_early_input_stage EXIT
resume_termination_signals
[[ -n ${input_stage} ]] || die "mktemp returned an empty input staging path"
[[ ${input_stage} == /var/tmp/autostream-worker-install.* &&
  $(dirname -- "${input_stage}") == "/var/tmp" &&
  -d ${input_stage} && ! -L ${input_stage} &&
  $(readlink -f -- "${input_stage}") == "${input_stage}" &&
  $(stat -c '%U:%G:%a' -- "${input_stage}") == "root:root:700" ]] || \
  die "mktemp returned an unsafe input staging directory"
readonly INPUT_STAGE="${input_stage}"
readonly UNPACK_DIR="${INPUT_STAGE}/unpack"
managed_candidate=""
managed_release_created=false
managed_release_created_identity=""
installation_committed=false
current_changed=false
previous_current_target=""
unit_installed=false
previous_unit_exists=false
previous_unit_mode=""
previous_unit_identity=""
previous_unit_sha256=""
legacy_unit_needs_backup=false
created_env=false
created_env_identity=""
created_env_sha256=""
preserve_input_stage=false
declare -a changed_public_paths=()
declare -a previous_public_kinds=()
declare -a previous_public_targets=()
declare -a previous_public_recoveries=()
declare -A interrupted_public_backups=()
legacy_backup_stage=""
lock_create_stage=""
created_autostream_group=false
created_autostream_group_gid=""
created_autostream_group_record=""
created_autostream_user=false
created_autostream_user_uid=""
created_autostream_user_gid=""
created_autostream_user_record=""
declare -a temporary_rollback_paths=()
declare -a journaled_directory_paths=()
declare -A directory_journaled=()
declare -A directory_existed=()
declare -A directory_original_identity=()
declare -A directory_original_owner=()
declare -A directory_original_mode=()
declare -A directory_created_identity=()
declare -A directory_retain_if_nonempty=()
declare -A preexisting_legacy_backup_identity=()
declare -A preexisting_legacy_backup_digest=()
declare -a mutated_filesystem_parents=("/var/tmp" "${INPUT_STAGE}")

register_temporary_rollback_path() {
  local path=$1
  local recorded

  [[ -n ${path} && ${path} == /* ]] || \
    die "temporary rollback path is empty or not absolute"
  for recorded in "${temporary_rollback_paths[@]}"; do
    [[ ${recorded} == "${path}" ]] && return 0
  done
  temporary_rollback_paths+=("${path}")
}

journal_root_directory_before_mutation() {
  local path=$1
  local retain_if_nonempty=${2-false}

  [[ ${directory_journaled["${path}"]-false} != true ]] || return 0
  directory_journaled["${path}"]=true
  directory_retain_if_nonempty["${path}"]="${retain_if_nonempty}"
  journaled_directory_paths+=("${path}")
  if [[ -e ${path} || -L ${path} ]]; then
    [[ -d ${path} && ! -L ${path} &&
      $(readlink -f -- "${path}") == "${path}" ]] || \
      die "root-owned directory path is unsafe before mutation: ${path}"
    directory_existed["${path}"]=true
    directory_original_identity["${path}"]="$(stat -c '%d:%i' -- "${path}")"
    directory_original_owner["${path}"]="$(stat -c '%u:%g' -- "${path}")"
    directory_original_mode["${path}"]="$(stat -c '%a' -- "${path}")"
  else
    directory_existed["${path}"]=false
  fi
}

record_mutated_parent() {
  local parent=$1
  local recorded

  for recorded in "${mutated_filesystem_parents[@]}"; do
    [[ ${recorded} == "${parent}" ]] && return 0
  done
  mutated_filesystem_parents+=("${parent}")
}

sync_installation_parents() {
  local parent

  for parent in "${mutated_filesystem_parents[@]}"; do
    [[ -d ${parent} && ! -L ${parent} ]] || \
      die "mutated filesystem parent is missing or unsafe before commit: ${parent}"
    sync -f "${parent}" || \
      die "failed to sync filesystem parent before commit: ${parent}"
  done
}

best_effort_sync_mutated_parents() {
  local parent
  local failed=false

  for parent in "${mutated_filesystem_parents[@]}"; do
    if [[ -d ${parent} && ! -L ${parent} ]]; then
      sync -f "${parent}" || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

rollback_public_links() {
  local index
  local path
  local kind
  local target
  local recovery
  local rollback_next
  local expected_digest
  local expected_metadata
  local failed=false

  for ((index=${#changed_public_paths[@]} - 1; index >= 0; index--)); do
    path="${changed_public_paths[index]}"
    kind="${previous_public_kinds[index]}"
    target="${previous_public_targets[index]}"
    recovery="${previous_public_recoveries[index]}"
    case "${kind}" in
      regular)
        if [[ ! -f ${recovery} || -L ${recovery} ]]; then
          failed=true
          continue
        fi
        expected_digest="$(sha256sum -- "${recovery}" | awk 'NR == 1 { print $1 }')"
        expected_metadata="$(stat -c '%u:%g:%a:%s' -- "${recovery}")"
        rollback_next="${path}.rollback.$$"
        if [[ -e ${rollback_next} || -L ${rollback_next} ]]; then
          failed=true
          continue
        fi
        register_temporary_rollback_path "${rollback_next}"
        if cp -a -- "${recovery}" "${rollback_next}"; then
          mv -Tf -- "${rollback_next}" "${path}" || failed=true
        else
          failed=true
        fi
        [[ -f ${path} &&
          ! -L ${path} &&
          $(stat -c '%u:%g:%a:%s' -- "${path}") == "${expected_metadata}" &&
          $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == "${expected_digest}" ]] || \
          failed=true
        ;;
      symlink)
        rollback_next="${path}.rollback.$$"
        if [[ -e ${rollback_next} || -L ${rollback_next} ]]; then
          failed=true
          continue
        fi
        register_temporary_rollback_path "${rollback_next}"
        ln -s -- "${target}" "${rollback_next}" || failed=true
        if [[ -L ${rollback_next} ]]; then
          mv -Tf -- "${rollback_next}" "${path}" || failed=true
        fi
        [[ -L ${path} && $(readlink -- "${path}") == "${target}" ]] || failed=true
        ;;
      absent)
        rm -f -- "${path}" || failed=true
        [[ ! -e ${path} && ! -L ${path} ]] || failed=true
        ;;
    esac
    sync -f "$(dirname -- "${path}")" || failed=true
  done
  [[ ${failed} == false ]]
}

rollback_current_link() {
  local rollback_next
  local failed=false

  [[ ${current_changed} == true ]] || return 0
  if [[ -n ${previous_current_target} ]]; then
    rollback_next="${MANAGED_ROOT}/.current.rollback.$$"
    [[ ! -e ${rollback_next} && ! -L ${rollback_next} ]] || return 1
    register_temporary_rollback_path "${rollback_next}"
    ln -s -- "${previous_current_target}" "${rollback_next}" || failed=true
    if [[ -L ${rollback_next} ]]; then
      mv -Tf -- "${rollback_next}" "${CURRENT_LINK}" || failed=true
    fi
    [[ -L ${CURRENT_LINK} &&
      $(readlink -- "${CURRENT_LINK}") == "${previous_current_target}" ]] || \
      failed=true
  else
    rm -f -- "${CURRENT_LINK}" || failed=true
    [[ ! -e ${CURRENT_LINK} && ! -L ${CURRENT_LINK} ]] || failed=true
  fi
  sync -f "${MANAGED_ROOT}" || failed=true
  [[ ${failed} == false ]]
}

rollback_unit_and_environment() {
  local unit_rollback_next
  local unit_recovered=true
  local failed=false

  if [[ ${unit_installed} == true ]]; then
    if [[ ${previous_unit_exists} == true ]]; then
      unit_recovered=false
      unit_rollback_next="${UNIT_DEST}.rollback.$$"
      if [[ ! -e ${unit_rollback_next} && ! -L ${unit_rollback_next} ]]; then
        register_temporary_rollback_path "${unit_rollback_next}"
      else
        failed=true
      fi
      if [[ ${failed} == false &&
        -f ${INPUT_STAGE}/previous-autostream-worker.service &&
        ! -L ${INPUT_STAGE}/previous-autostream-worker.service ]] &&
        install -o root -g root -m "${previous_unit_mode}" \
          "${INPUT_STAGE}/previous-autostream-worker.service" \
          "${unit_rollback_next}" &&
        mv -Tf -- "${unit_rollback_next}" "${UNIT_DEST}" &&
        [[ -f ${UNIT_DEST} &&
          ! -L ${UNIT_DEST} &&
          $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == \
            "root:root:${previous_unit_mode}" &&
          $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
            "${previous_unit_sha256}" ]]; then
        unit_recovered=true
      else
        failed=true
      fi
    else
      rm -f -- "${UNIT_DEST}" || failed=true
      [[ ! -e ${UNIT_DEST} && ! -L ${UNIT_DEST} ]] || {
        unit_recovered=false
        failed=true
      }
    fi
    if [[ ${unit_recovered} == true ]]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  elif [[ ${previous_unit_exists} == true ]]; then
    [[ -f ${UNIT_DEST} &&
      ! -L ${UNIT_DEST} &&
      $(stat -c '%U:%G:%a' -- "${UNIT_DEST}") == \
        "root:root:${previous_unit_mode}" &&
      $(sha256sum -- "${UNIT_DEST}" | awk 'NR == 1 { print $1 }') == \
        "${previous_unit_sha256}" ]] || {
      unit_recovered=false
      failed=true
    }
  fi
  sync -f /etc/systemd/system || failed=true

  if [[ ${created_env} == true ]]; then
    if [[ -f ${ENV_DEST} &&
      ! -L ${ENV_DEST} &&
      $(stat -c '%d:%i:%s:%Y:%f:%u:%g' -- "${ENV_DEST}") == "${created_env_identity}" &&
      $(sha256sum -- "${ENV_DEST}" | awk 'NR == 1 { print $1 }') == "${created_env_sha256}" ]]; then
      rm -f -- "${ENV_DEST}" || failed=true
      [[ ! -e ${ENV_DEST} && ! -L ${ENV_DEST} ]] || failed=true
    else
      printf 'install-autostream-worker: preserving environment file modified during failed installation: %s\n' \
        "${ENV_DEST}" >&2
    fi
  fi
  sync -f /etc/autostream || failed=true
  if [[ ${unit_recovered} != true ]]; then
    preserve_input_stage=true
  fi
  [[ ${failed} == false ]]
}

rollback_state_directory() {
  local failed=false

  [[ ${state_dir_mutated} == true ]] || return 0
  if [[ ${state_dir_existed} == true ]]; then
    if [[ -d ${STATE_DIR} &&
      ! -L ${STATE_DIR} &&
      $(readlink -f -- "${STATE_DIR}") == "${STATE_DIR}" &&
      $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_original_identity}" ]]; then
      chown -- "${state_dir_original_owner}" "${STATE_DIR}" || failed=true
      chmod -- "${state_dir_original_mode}" "${STATE_DIR}" || failed=true
      [[ $(stat -c '%d:%i:%u:%g:%a' -- "${STATE_DIR}") == \
        "${state_dir_original_identity}:${state_dir_original_owner}:${state_dir_original_mode}" ]] || \
        failed=true
    else
      failed=true
    fi
  elif [[ -e ${STATE_DIR} || -L ${STATE_DIR} ]]; then
    if [[ -d ${STATE_DIR} &&
      ! -L ${STATE_DIR} &&
      $(readlink -f -- "${STATE_DIR}") == "${STATE_DIR}" &&
      -n ${state_dir_created_identity} &&
      $(stat -c '%d:%i' -- "${STATE_DIR}") == "${state_dir_created_identity}" &&
      -z $(find "${STATE_DIR}" -mindepth 1 -print -quit) ]]; then
      rmdir -- "${STATE_DIR}" || failed=true
      [[ ! -e ${STATE_DIR} && ! -L ${STATE_DIR} ]] || failed=true
    else
      failed=true
    fi
  fi
  sync -f "$(dirname -- "${STATE_DIR}")" || failed=true
  [[ ${failed} == false ]]
}

rollback_created_managed_release() {
  local failed=false
  local public_path

  [[ ${managed_release_created} == true ]] || return 0
  if [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]]; then
    return 0
  fi
  if [[ ! -d ${RELEASE_DIR} ||
    -L ${RELEASE_DIR} ||
    $(readlink -f -- "${RELEASE_DIR}") != "${RELEASE_DIR}" ||
    $(stat -c '%d:%i' -- "${RELEASE_DIR}") != "${managed_release_created_identity}" ]]; then
    return 1
  fi
  if [[ -L ${CURRENT_LINK} &&
    $(readlink -f -- "${CURRENT_LINK}") == "${RELEASE_DIR}" ]]; then
    return 1
  fi
  for public_path in "${PUBLIC_BINARY}" "${PUBLIC_ALIAS}"; do
    if [[ -L ${public_path} &&
      $(readlink -f -- "${public_path}") == "${RELEASE_DIR}/bin/autostream-worker" ]]; then
      return 1
    fi
  done
  rm -rf -- "${RELEASE_DIR}" || failed=true
  [[ ! -e ${RELEASE_DIR} && ! -L ${RELEASE_DIR} ]] || failed=true
  sync -f "${RELEASES_DIR}" || failed=true
  [[ ${failed} == false ]]
}

rollback_journaled_directories() {
  local index
  local path
  local current_mode
  local failed=false

  for ((index=${#journaled_directory_paths[@]} - 1; index >= 0; index--)); do
    path="${journaled_directory_paths[index]}"
    if [[ ${directory_existed["${path}"]} == true ]]; then
      if [[ -d ${path} &&
        ! -L ${path} &&
        $(readlink -f -- "${path}") == "${path}" &&
        $(stat -c '%d:%i' -- "${path}") == "${directory_original_identity["${path}"]}" ]]; then
        chown -- "${directory_original_owner["${path}"]}" "${path}" || failed=true
        chmod -- "${directory_original_mode["${path}"]}" "${path}" || failed=true
        [[ $(stat -c '%d:%i:%u:%g:%a' -- "${path}") == \
          "${directory_original_identity["${path}"]}:${directory_original_owner["${path}"]}:${directory_original_mode["${path}"]}" ]] || \
          failed=true
      else
        failed=true
      fi
    elif [[ -e ${path} || -L ${path} ]]; then
      if [[ -d ${path} &&
        ! -L ${path} &&
        $(readlink -f -- "${path}") == "${path}" &&
        -n ${directory_created_identity["${path}"]-} &&
        $(stat -c '%d:%i' -- "${path}") == "${directory_created_identity["${path}"]}" ]]; then
        if [[ -z $(find "${path}" -mindepth 1 -print -quit) ]]; then
          rmdir -- "${path}" || failed=true
          [[ ! -e ${path} && ! -L ${path} ]] || failed=true
        else
          current_mode="$(stat -c '%a' -- "${path}")"
          if [[ ${directory_retain_if_nonempty["${path}"]} == true &&
            $(stat -c '%U:%G' -- "${path}") == "root:root" &&
            ${current_mode} =~ ^[0-7]+$ ]] &&
            (( (8#${current_mode} & 0022) == 0 )); then
            printf 'install-autostream-worker: retaining non-empty durable backup directory after rollback: %s\n' \
              "${path}" >&2
          else
            failed=true
          fi
        fi
      else
        failed=true
      fi
    fi
    if [[ -d $(dirname -- "${path}") && ! -L $(dirname -- "${path}") ]]; then
      sync -f "$(dirname -- "${path}")" || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

rollback_autostream_account() {
  local failed=false
  local current_group
  local current_gid

  if [[ ${created_autostream_user} == true ]]; then
    if id autostream >/dev/null 2>&1 &&
      [[ $(id -u autostream) == "${created_autostream_user_uid}" &&
        $(id -g autostream) == "${created_autostream_user_gid}" &&
        $(getent passwd autostream) == "${created_autostream_user_record}" ]]; then
      userdel autostream || failed=true
      id autostream >/dev/null 2>&1 && failed=true
    else
      failed=true
    fi
  fi
  if [[ ${created_autostream_group} == true ]]; then
    current_group="$(getent group autostream 2>/dev/null || true)"
    if [[ -z ${current_group} ]]; then
      :
    else
      current_gid="$(
        printf '%s\n' "${current_group}" | awk -F: 'NR == 1 { print $3 }'
      )"
      if [[ ${current_gid} == "${created_autostream_group_gid}" &&
        ${current_group} == "${created_autostream_group_record}" ]] &&
        ! id autostream >/dev/null 2>&1; then
        groupdel autostream || failed=true
        getent group autostream >/dev/null && failed=true
      else
        failed=true
      fi
    fi
  fi
  [[ ${failed} == false ]]
}

verify_preexisting_legacy_backups() {
  local path
  local failed=false

  for path in "${!preexisting_legacy_backup_identity[@]}"; do
    [[ -f ${path} &&
      ! -L ${path} &&
      $(stat -c '%d:%i:%s:%Y:%Z:%f:%u:%g:%a' -- "${path}") == \
        "${preexisting_legacy_backup_identity["${path}"]}" &&
      $(sha256sum -- "${path}" | awk 'NR == 1 { print $1 }') == \
        "${preexisting_legacy_backup_digest["${path}"]}" ]] || \
      failed=true
  done
  [[ ${failed} == false ]]
}

cleanup_temporary_rollback_paths() {
  local index
  local path
  local failed=false

  for ((index=${#temporary_rollback_paths[@]} - 1; index >= 0; index--)); do
    path="${temporary_rollback_paths[index]}"
    if [[ -e ${path} || -L ${path} ]]; then
      rm -f -- "${path}" || failed=true
      [[ ! -e ${path} && ! -L ${path} ]] || failed=true
    fi
  done
  [[ ${failed} == false ]]
}

cleanup_managed_candidate() {
  [[ -n ${managed_candidate} ]] || return 0
  [[ ! -e ${managed_candidate} && ! -L ${managed_candidate} ]] && return 0
  [[ ${managed_candidate} == "${RELEASES_DIR}/.install-${VERSION}."* &&
    $(dirname -- "${managed_candidate}") == "${RELEASES_DIR}" &&
    -d ${managed_candidate} &&
    ! -L ${managed_candidate} &&
    $(readlink -f -- "${managed_candidate}") == "${managed_candidate}" ]] || \
    return 1
  rm -rf -- "${managed_candidate}"
  [[ ! -e ${managed_candidate} && ! -L ${managed_candidate} ]]
}

cleanup() {
  local original_status=$?

